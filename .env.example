APP_NAME="Valima Biriyani"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=base64:VALIMA_SECURE_KEY_GENERATE_32_BYTES_HEX

# Database Configuration
# Supported drivers: mysql, sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u526658771_restaurant_erp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# SQLite Fallback (useful for automated testing and standalone verification)
DB_SQLITE_PATH=storage/database.sqlite

# Session & Timezone
TIMEZONE=Asia/Kolkata
SESSION_NAME=valima_session
SESSION_LIFETIME=7200

# Restaurant Details
RESTAURANT_NAME="Valima Biriyani"
RESTAURANT_TAGLINE="Authentic Traditional Dum Biriyani & More"
RESTAURANT_PHONE="+91 98765 43210"
RESTAURANT_WHATSAPP="+919876543210"
RESTAURANT_ADDRESS="Grand Southern Trunk Rd, Chennai, Tamil Nadu 600045"
RESTAURANT_GSTIN=""
RESTAURANT_CURRENCY_SYMBOL="₹"
RESTAURANT_CURRENCY_CODE="INR"

# Business Logic
LOYALTY_POINTS_PER_ORDER=10
LOYALTY_POINT_VALUE_INR=1.00
MIN_ORDER_AMOUNT=0.00
DEFAULT_TAX_PERCENT=5.00

# Optional Integration: Razorpay (Test mode switch, off by default)
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Integration: WhatsApp Cloud API (Free wa.me links used by default)
WHATSAPP_API_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Optional Integration: Make.com outgoing webhooks (off by default)
MAKE_WEBHOOK_ENABLED=false
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=
