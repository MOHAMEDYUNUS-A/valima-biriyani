!/storage/exports/.gitkeep
!/storage/private/.gitkeep

# Uploads
/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/menu/
/public/uploads/menu/*
!/public/uploads/menu/.gitkeep

